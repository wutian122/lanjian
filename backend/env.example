# =============================================
# lanjian v3.0.0 Backend 閰嶇疆鏂囦欢
# =============================================
# 澶嶅埗姝ゆ枃浠朵负 .env 骞跺～鍏ュ疄闄呴厤缃?
# 璇︾粏璇存槑璇峰弬闃?docs/CONFIGURATION.md

# =============================================
# 鏁版嵁搴撻厤缃?
# =============================================
# PostgreSQL 鏁版嵁搴撹繛鎺ラ厤缃?
# Docker Compose 閮ㄧ讲鏃朵娇鐢?db 浣滀负鏈嶅姟鍣ㄥ湴鍧€
# P3-1: POSTGRES_PASSWORD is REQUIRED and must satisfy the policy in config.py::validate_postgres_password.
#   >= 12 chars, not in the weak-value blacklist (postgres/password/123456/admin/root/test/changeme/postgres123).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=lanjian

# 瀹屾暣鏁版嵁搴撹繛鎺ュ瓧绗︿覆锛堝彲閫夛紝浼氳鐩栦笂杩伴厤缃級
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/lanjian

# =============================================
# 瀹夊叏閰嶇疆
# =============================================
# JWT 绛惧悕瀵嗛挜 - 鐢熶骇鐜蹇呴』淇敼涓洪殢鏈哄瓧绗︿覆锛?
# 寤鸿浣跨敤: openssl rand -hex 32
# JWT signing key -- REQUIRED. No default. Backend refuses to start when unset or weak.
# Constraints: length >= 32, not in the weak-value blacklist
# (see backend/app/core/config.py::_INSECURE_SECRET_KEYS).
# Generate with either:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -hex 32
# WARNING: leaking this value is equivalent to leaking every issued JWT.
SECRET_KEY=

# P0-3: CORS allow-list (comma-separated). Required for the frontend to talk to backend.
# When unset, credentials-bearing requests are blocked. Include every host origin the frontend uses.
# Example (two servers, both http):
#   CORS_ALLOWED_ORIGINS=http://frontend-host-a.example.com,http://frontend-host-b.example.com
CORS_ALLOWED_ORIGINS=

# JWT 鍔犲瘑绠楁硶
ALGORITHM=HS256

# Token 杩囨湡鏃堕棿锛堝垎閽燂級锛岄粯璁?8 澶?
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# P0-4: Super admin bootstrap. Password is REQUIRED and must satisfy the
# password policy: >= 12 chars, upper + lower + digit + special char.
# When unset or too weak, init_db skips super-admin creation and logs how to fix.
# Generate a strong one, then set it here or in the deployment env, e.g.:
#   python -c "import secrets, string, random; r=random.SystemRandom(); print(''.join(r.choice(string.ascii_letters+string.digits+'!@#$%^&*') for _ in range(20)))"
# After first login, immediately change it in the UI (is_first_login=True enforces this).
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin
SUPERADMIN_DEPARTMENT=Security
SUPERADMIN_PHONE=13800138000

# =============================================
# LLM 閫氱敤閰嶇疆
# =============================================
# 鏀寔鐨?provider:
# - LiteLLM 閫傞厤鍣? openai, gemini, claude, qwen, deepseek, zhipu, moonshot, ollama
# - 鍘熺敓閫傞厤鍣? baidu, minimax, doubao
LLM_PROVIDER=openai

# API 瀵嗛挜
LLM_API_KEY=sk-your-api-key

# 妯″瀷鍚嶇О锛堢暀绌轰娇鐢?provider 榛樿妯″瀷锛?
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Gemini: gemini-2.0-flash, gemini-1.5-pro
# Claude: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Qwen: qwen-turbo, qwen-plus, qwen-max
# DeepSeek: deepseek-chat, deepseek-coder
# Zhipu: glm-4-flash, glm-4
# Moonshot: moonshot-v1-8k, moonshot-v1-32k
# Ollama: llama3, codellama, qwen2.5, deepseek-coder
LLM_MODEL=

# 鑷畾涔?API 绔偣锛圓PI 涓浆绔欙級
# 绀轰緥: https://your-proxy.com/v1
LLM_BASE_URL=

# 璇锋眰瓒呮椂鏃堕棿锛堢锛?
LLM_TIMEOUT=150

# 鐢熸垚娓╁害锛?-1锛岃秺浣庤秺纭畾鎬э級
LLM_TEMPERATURE=0.1

# 鏈€澶х敓鎴?Token 鏁?
LLM_MAX_TOKENS=4096

# =============================================
# 鍚勫钩鍙扮嫭绔嬮厤缃紙鍙€夛級
# =============================================
# 濡傛灉闇€瑕佸悓鏃堕厤缃涓钩鍙帮紝鍙互鍗曠嫭璁剧疆
# 杩愯鏃跺彲閫氳繃 /admin 椤甸潰鍒囨崲

# OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
# GEMINI_API_KEY=xxx

# Anthropic Claude
# CLAUDE_API_KEY=sk-ant-xxx

# 闃块噷浜戦€氫箟鍗冮棶
# QWEN_API_KEY=sk-xxx

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxx

# 鏅鸿氨 AI
# ZHIPU_API_KEY=xxx

# 鏈堜箣鏆楅潰 Kimi
# MOONSHOT_API_KEY=sk-xxx

# 鐧惧害鏂囧績涓€瑷€锛堟牸寮? api_key:secret_key锛?
# BAIDU_API_KEY=your_api_key:your_secret_key

# MiniMax
# MINIMAX_API_KEY=xxx

# 瀛楄妭璞嗗寘
# DOUBAO_API_KEY=xxx

# Ollama 鏈湴妯″瀷
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================
# Agent 瀹¤閰嶇疆 (Multi-Agent v3.0.0 鏍稿績蹇呴』)
# =============================================
# Agent 瀹¤寮€鍏筹紙蹇呴』寮€鍚紝鏄牳蹇冨姛鑳斤級
AGENT_ENABLED=true

# Agent 鏈€澶ц凯浠ｆ鏁?
AGENT_MAX_ITERATIONS=5

# Agent 鍗曟瀹¤瓒呮椂鏃堕棿锛堢锛?
AGENT_TIMEOUT=1800

# Redis 閰嶇疆锛圓gent 浠诲姟闃熷垪 - 蹇呴』锛?
# Docker Compose 閮ㄧ讲鏃朵娇鐢?redis 浣滀负鏈嶅姟鍣ㄥ湴鍧€
REDIS_URL=redis://localhost:6379/0

# =============================================
# 宓屽叆妯″瀷閰嶇疆锛圧AG 鍔熻兘锛岀嫭绔嬩簬涓?LLM锛?
# =============================================
# 宓屽叆妯″瀷 provider: openai, ollama, cohere, huggingface
EMBEDDING_PROVIDER=openai

# 宓屽叆妯″瀷鍚嶇О
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Ollama: nomic-embed-text, mxbai-embed-large
EMBEDDING_MODEL=text-embedding-3-small

# 宓屽叆妯″瀷 API Key锛堢暀绌哄垯浣跨敤 LLM_API_KEY锛?
EMBEDDING_API_KEY=

# 宓屽叆妯″瀷 Base URL锛堢暀绌哄垯浣跨敤榛樿鍊硷級
EMBEDDING_BASE_URL=

# =============================================
# 鍚戦噺鏁版嵁搴撻厤缃紙RAG 鍔熻兘锛?
# =============================================
# 鍚戦噺鏁版嵁搴撶被鍨? chroma
VECTOR_DB_TYPE=chroma

# ChromaDB 閰嶇疆锛堟湰鍦版ā寮忥級
CHROMA_PERSIST_DIRECTORY=./data/chroma

# =============================================
# 娌欑閰嶇疆锛堟紡娲為獙璇?- 鏍稿績蹇呴』锛?
# =============================================
# 娌欑鍔熻兘寮€鍏筹紙蹇呴』寮€鍚紝鏄紡娲為獙璇佺殑鏍稿績缁勪欢锛?
SANDBOX_ENABLED=true

# 娌欑 Docker 闀滃儚
# 鏋勫缓鏂瑰紡 1: docker compose build sandbox
# 鏋勫缓鏂瑰紡 2: cd docker/sandbox && ./build.sh
SANDBOX_IMAGE=wutian449/lanjian-sandbox:latest

# 娌欑鍐呭瓨闄愬埗
SANDBOX_MEMORY_LIMIT=512m

# 娌欑 CPU 闄愬埗锛堟牳蹇冩暟锛?
SANDBOX_CPU_LIMIT=1.0

# 鏄惁绂佺敤娌欑缃戠粶锛堝畨鍏ㄥ缓璁紑鍚級
SANDBOX_NETWORK_DISABLED=true

# 娌欑鎵ц瓒呮椂鏃堕棿锛堢锛?
SANDBOX_TIMEOUT=30

# =============================================
# Git 浠撳簱閰嶇疆
# =============================================
# GitHub Personal Access Token
# 鑾峰彇鍦板潃: https://github.com/settings/tokens
# 鏉冮檺瑕佹眰: repo (绉佹湁浠撳簱) 鎴?public_repo (鍏紑浠撳簱)
GITHUB_TOKEN=

# GitLab Personal Access Token
# 鑾峰彇鍦板潃: https://gitlab.com/-/profile/personal_access_tokens
# 鏉冮檺瑕佹眰: read_repository
GITLAB_TOKEN=

# Gitea Access Token
# 鑾峰彇鍦板潃: https://[your-gitea-instance]/user/settings/applications
# 鏉冮檺瑕佹眰: read_repository
GITEA_TOKEN=

# =============================================
# 鎵弿閰嶇疆
# =============================================
# 鍗曟鎵弿鏈€澶ф枃浠舵暟
MAX_ANALYZE_FILES=0

# 鍗曟枃浠舵渶澶уぇ灏忥紙瀛楄妭锛夛紝榛樿 200KB
MAX_FILE_SIZE_BYTES=204800

# LLM 骞跺彂璇锋眰鏁帮紙娉ㄦ剰 API 闄愭祦锛?
LLM_CONCURRENCY=3

# LLM 璇锋眰闂撮殧锛堟绉掞級锛岄伩鍏嶈Е鍙戦檺娴?
LLM_GAP_MS=2000

# =============================================
# 瀛樺偍閰嶇疆
# =============================================
# ZIP 鏂囦欢瀛樺偍鐩綍
ZIP_STORAGE_PATH=./uploads/zip_files

# =============================================
# v3.1 Fusion: code-audit-main 铻嶅悎鍔熻兘寮€鍏?
# =============================================
# 瀹夊叏鎺у埗寮曟搸 (Control-driven Audit)
CONTROLS_ENABLED=true

# D1-D10 瑕嗙洊鐭╅樀杩借釜
ENABLE_COVERAGE_TRACKING=true

# 澧炲己闃插够瑙夎鍒?
ENABLE_ANTI_HALLUCINATION=true

# Agent 鍚堢害绾︽潫 (杞/宸ュ叿闄愬埗)
ENABLE_AGENT_CONTRACT=true

# 鎺у埗椹卞姩瀹¤ (D3鎺堟潈/D9涓氬姟閫昏緫)
ENABLE_CONTROL_DRIVEN_AUDIT=true

# 鏀诲嚮閾炬嫾瑁?(瀹為獙鎬?
# ENABLE_ATTACK_CHAINS=false

# 璇姤 Kill Switch (瀹為獙鎬?
# ENABLE_FP_KILL_SWITCH=false

# Agent 鍚堢害杞闄愬埗
AGENT_MAX_TURNS=50
DEEP_AUDIT_R1_TURNS=25
DEEP_AUDIT_R2_TURNS=20

# 瑕嗙洊鐭╅樀缁堟鏉′欢
COVERAGE_TERMINATION_THRESHOLD=8
COVERAGE_MIN_FINDINGS=10

# =============================================
# 杈撳嚭閰嶇疆
# =============================================
# 鍒嗘瀽缁撴灉杈撳嚭璇█
# zh-CN: 涓枃
# en-US: 鑻辨枃
OUTPUT_LANGUAGE=zh-CN
